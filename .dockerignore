# Keep the build context small and stable so Docker layer caching is effective.
# NOTE: build_info.py is generated by scripts/build-info.sh before the image
# build and IS required inside the image - do not ignore it here.

.git
.github
.venv
venv

**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache

dist
build
**/*.egg-info
**/wheels

.idea
.vscode
.DS_Store
